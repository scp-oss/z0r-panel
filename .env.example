# Скопируй в .env и заполни перед первым запуском.
#
# Эти же MYSQL_*/ZENITH_ENVIRONMENT_* значения ПРОДУБЛИРОВАНЫ из
# Zenith/.env -- отдельный репозиторий/процесс, общего .env с Zenith
# больше нет (см. config.py). БД от этого не меняется -- панель как был,
# так и остаётся обычным клиентом той же MySQL z2r_genome.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=z2r_genome
MYSQL_USER=zenith
MYSQL_PASSWORD=change-me-app

# Локальное окружение -- за какую ноду панель показывает control-статус
# на /controls (через set_strategy_cli.sh get/max, read-only). Должно
# совпадать с тем, что в Zenith/.env этого же сервера.
ZENITH_ENVIRONMENT_NAME=prod-domru
ZENITH_ENVIRONMENT_PROVIDER=domru

# Логин см. gen_password_hash.py -- сам пароль в .env НЕ хранится,
# только pbkdf2-хэш.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD_HASH=
# Сгенерировать: python3 -c 'import secrets; print(secrets.token_hex(32))'
PANEL_SESSION_SECRET=

# Положи Cloudflare Origin CA сертификат+ключ в tls/cf-origin.pem и
# tls/cf-origin-key.pem (см. README "Публикация панели через
# Cloudflare") -- панель подхватит их сама по умолчанию, PANEL_TLS_CERT/
# PANEL_TLS_KEY ниже раскомментировать НЕ нужно, если пути стандартные.
# Файлов там нет -- голый HTTP на PANEL_HOST (127.0.0.1, для локальной
# разработки). Есть -- панель сама слушает TLS на 0.0.0.0:PANEL_PORT
# (PANEL_HOST в этом режиме не используется), PANEL_PORT тогда = боевой
# альт-порт Cloudflare (443/2053/2083/2087/2096/8443 -- только эти шесть
# Cloudflare вообще проксирует на orange-cloud записях).
PANEL_HOST=127.0.0.1
PANEL_PORT=8766
# PANEL_TLS_CERT=/путь/если/не/tls/cf-origin.pem
# PANEL_TLS_KEY=/путь/если/не/tls/cf-origin-key.pem

# Внешний адрес ЭТОЙ панели (то, что видно снаружи через Cloudflare --
# не обязательно совпадает с PANEL_HOST/PANEL_PORT, это адрес БИНДА).
# Задан -- при создании токена на /nodes выводится готовый блок
# PANEL_URL/PANEL_NODE_TOKEN для копипаста целиком в z0r на новой ноде,
# не по полю. Не задан -- показывается только токен.
# PANEL_PUBLIC_URL=https://panel.neth.de5.net:2087

# Путь к z2r_autobench (для set_strategy_cli.sh, read-only get/max на
# странице /controls) -- дефолт подходит, если z0r-panel лежит рядом с
# Zenith в /opt/z2r_autobench/, меняй только при нестандартной раскладке.
# Z2R_AUTOBENCH_DIR=/opt/z2r_autobench

# Пути к оркестратору Zenith (для кнопки "запустить подбор" на /controls,
# см. runner.py) -- дефолты подходят при стандартной раскладке
# ($Z2R_AUTOBENCH_DIR/Zenith/orchestrator), меняй только при нестандартной.
# ZENITH_ORCHESTRATOR_DIR=/opt/z2r_autobench/Zenith/orchestrator
# ZENITH_VENV_PYTHON=/opt/z2r_autobench/Zenith/orchestrator/venv/bin/python3

# Периодический автозапуск и автопродвижение -- НЕЗАВИСИМЫЕ от панели
# systemd-юниты (zenith-autorun.service/zenith-promoter.service, ставятся
# и настраиваются через z0r пункт 30 -> подменю Zenith -> "Автономный
# режим", интервалы/пороги -- в Zenith/.env, не здесь). Панель на
# /controls -- только кнопки start/stop/log поверх этих же юнитов, см.
# Zenith/README.md "Автономный режим".

# --- Для нод (не для самой панели) -- см. Zenith/orchestrator/sync_client.py ---
# PANEL_URL=https://<хост-панели>:<альт-порт Cloudflare>
# PANEL_NODE_TOKEN=<выдаётся на /nodes в UI панели>
