.env
__pycache__/
*.pyc
venv/

# Cloudflare Origin CA сертификат/ключ -- живут тут на конкретном
# сервере, никогда не коммитятся, см. README "Публикация панели через
# Cloudflare"
tls/

# Логи прогонов, запущенных кнопкой /controls/run (см. runner.py) --
# живут на конкретном сервере, не артефакт репозитория.
run_logs/

# Автосгенерированный секрет подписи сессионной куки (см. config.py) --
# специфичен для конкретного сервера, никогда не коммитится.
.session_secret
